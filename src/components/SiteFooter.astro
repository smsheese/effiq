---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<footer class="mt-8 border-t border-border/80 bg-card/40">
  <div
    class:list={[
      "mx-auto grid gap-8 px-4 py-10 sm:py-12",
      compact ? "max-w-3xl" : "max-w-[1500px] md:grid-cols-[1.4fr_1fr]",
    ]}
  >
    <div class="space-y-4">
      <div class="flex items-center gap-2.5">
        <span
          class="flex size-8 items-center justify-center rounded-xl bg-primary text-xs font-bold text-primary-foreground"
          aria-hidden="true"
        >
          eq
        </span>
        <div>
          <p class="text-sm font-bold tracking-tight text-foreground">effiq</p>
          <p class="text-[10px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
            efficiency × iq
          </p>
        </div>
      </div>
      <p class="max-w-xl text-sm leading-relaxed text-muted-foreground">
        Ranks capability per task dollar across OpenRouter, Cursor, and OpenCode Go, with Artificial Analysis benchmarks.
        Approximations have clear labels.
      </p>
      <p class="text-xs text-muted-foreground">
        Model providers:
        <a class="font-medium text-primary underline-offset-4 hover:underline" href="https://openrouter.ai" rel="noopener noreferrer">OpenRouter</a>,
        <a class="font-medium text-primary underline-offset-4 hover:underline" href="https://cursor.com/docs/models-and-pricing" rel="noopener noreferrer">Cursor</a>,
        and
        <a class="font-medium text-primary underline-offset-4 hover:underline" href="https://opencode.ai/docs/go/" rel="noopener noreferrer">OpenCode Go</a>
        · Benchmarks:
        <a class="font-medium text-primary underline-offset-4 hover:underline" href="https://artificialanalysis.ai" rel="noopener noreferrer">Artificial Analysis</a>
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Pages</p>
        <ul class="space-y-2 text-sm">
          <li><a class="text-foreground transition-colors hover:text-primary" href="/">Explorer</a></li>
          <li><a class="text-foreground transition-colors hover:text-primary" href="/methodology/">Methodology</a></li>
          <li><a class="text-foreground transition-colors hover:text-primary" href="/api/models.json">models.json</a></li>
          <li><a class="text-foreground transition-colors hover:text-primary" href="/api/models.csv">models.csv</a></li>
        </ul>
      </div>
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Meta</p>
        <ul class="space-y-2 text-sm">
          <li><a class="text-foreground transition-colors hover:text-primary" href="/api/health">health</a></li>
          <li><a class="text-foreground transition-colors hover:text-primary" href="/llms.txt">llms.txt</a></li>
          <li><a class="text-foreground transition-colors hover:text-primary" href="/sitemap.xml">sitemap</a></li>
          <li><a class="text-foreground transition-colors hover:text-primary" href="/robots.txt">robots</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class:list={["mx-auto flex flex-wrap items-center justify-between gap-2 border-t border-border/80 px-4 py-4 text-xs text-muted-foreground", compact ? "max-w-3xl" : "max-w-[1500px]"]}>
    <span>MIT © 2026 smsheese</span>
    <span class="font-mono">v0.2.0</span>
  </div>
</footer>
