---
import Layout from "@/layouts/Layout.astro";
import { ModelExplorer } from "@/components/ModelExplorer";
---

<Layout
  title="effiq — High-intelligence models per task dollar"
  description="effiq ranks LLM reasoning variants by capability per measured or estimated task cost. Default Intelligence floor 40, eight usage profiles, and adjustable efficiency weights."
>
  <header class="sticky top-0 z-50 border-b border-border/80 bg-background/85 backdrop-blur-md">
    <div class="mx-auto flex max-w-[1500px] items-center gap-3 px-4 py-3">
      <a href="/" class="group flex items-center gap-2.5 no-underline">
        <span
          class="flex size-8 items-center justify-center rounded-lg bg-primary text-sm font-bold tracking-tight text-primary-foreground shadow-sm"
          aria-hidden="true"
        >
          eq
        </span>
        <span class="flex flex-col leading-none">
          <span class="text-lg font-bold tracking-tight text-foreground">effiq</span>
          <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
            efficiency × iq
          </span>
        </span>
      </a>
      <nav class="ml-2 flex items-center gap-1.5">
        <a
          href="/methodology"
          class="rounded-lg px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-secondary hover:text-secondary-foreground"
        >
          Methodology
        </a>
      </nav>
      <p class="ml-auto hidden max-w-md truncate text-sm text-muted-foreground lg:block">
        Capability per task dollar — OpenRouter, Cursor, Artificial Analysis
      </p>
    </div>
  </header>

  <main>
    <ModelExplorer client:load />
  </main>

  <footer class="border-t border-border/80">
    <div class="mx-auto flex max-w-[1500px] flex-col gap-2 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>
        <span class="font-semibold text-foreground">effiq</span>
        · Model providers OpenRouter and Cursor · Benchmarks Artificial Analysis.
        Approximations have clear labels.
      </p>
      <a href="/methodology" class="text-primary underline-offset-2 hover:underline">Scoring methodology</a>
    </div>
  </footer>
</Layout>
