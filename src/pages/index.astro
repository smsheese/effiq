---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ModelExplorer } from "@/components/ModelExplorer";
import {
  PAGES,
  buildJsonLdGraph,
  websiteJsonLd,
  webApplicationJsonLd,
  datasetJsonLd,
} from "@/lib/site";

const page = PAGES.home;
const site = Astro.site?.href ?? "http://localhost:4321/";
const jsonLd = buildJsonLdGraph(site, [
  websiteJsonLd(site),
  webApplicationJsonLd(site),
  datasetJsonLd(site),
]);
---

<Layout
  title={page.title}
  description={page.description}
  ogImage={page.ogImage}
  jsonLd={jsonLd}
>
  <SiteHeader current="home" />

  <main id="main-content">
    <div class="mx-auto max-w-[1500px] px-4 pb-2 pt-10 sm:pt-12">
      <header class="mb-8 max-w-3xl space-y-4 border-b border-border/80 pb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
          Explorer
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-foreground text-balance sm:text-5xl">
          {page.heading}
        </h1>
        <p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
          Rank LLM reasoning variants by capability per measured or estimated task dollar.
          The default view keeps Artificial Analysis Intelligence at
          <strong class="font-semibold text-foreground">40</strong> or more.
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a
            href="/methodology/"
            class="inline-flex h-10 items-center justify-center rounded-xl border border-border bg-card px-4 text-sm font-semibold text-foreground shadow-xs transition-colors hover:bg-secondary"
          >
            Scoring methodology
          </a>
          <a
            href="/api/models.json"
            class="inline-flex h-10 items-center justify-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
          >
            Download matrix
          </a>
        </div>
      </header>
    </div>
    <ModelExplorer client:idle />
  </main>

  <SiteFooter />
</Layout>
