# =============================================================================
# effiq — Local Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development and testing:
#   cp .env.example .env
#
# NOTE: Never commit .env or any secret keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Primary Model & Provider API Keys
# -----------------------------------------------------------------------------

# OpenRouter API Key (https://openrouter.ai/settings/keys)
# Used for authenticated model catalog syncing, live endpoints query, and higher rate limits
OPENROUTER_API_KEY=

# Cursor API Key / Session Token (https://cursor.com)
# Used when querying Cursor endpoints or authenticating against Cursor documentation
CURSOR_API_KEY=

# Artificial Analysis API Key (https://artificialanalysis.ai)
# Used for live catalog & benchmark metric synchronization
ARTIFICIAL_ANALYSIS_API_KEY=

# Hugging Face User Access Token (https://huggingface.co/settings/tokens)
# Used for Open LLM Leaderboard API integration and dataset queries
HF_TOKEN=

# -----------------------------------------------------------------------------
# 2. Direct Foundation Model Provider Keys (Optional for local testing / benchmarks)
# -----------------------------------------------------------------------------

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# xAI Grok API Key (https://console.x.ai/)
XAI_API_KEY=

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 3. Data Sync & Cache Overrides (scripts/sync.ts & scripts/cursor_pricing_pyagent.py)
# -----------------------------------------------------------------------------

# Force a live refresh from OpenRouter during `npm run sync`
# Set to 1 to force fetch, or 0 / unset to use local cache if under 24 hours old
OPENROUTER_REFRESH=1

# OpenRouter raw cache file path
OPENROUTER_CACHE=./data/models-cache.json
CACHE_FILE=./data/models-cache.json

# Published matrix paths
MATRIX_FILE=./data/models-matrix.json
OUT_DIR=./data

# Local source file overrides (defaults to bundled repo data)
AA_CATALOG_PATH=./data/aa-catalog.json
CURSOR_MODELS_CSV=./data/cursor-models.csv
OPENCODE_GO_JSON=./data/opencode-go.json
SUBSCRIPTION_PLANS_JSON=./data/subscription-plans.json

# Cursor pricing documentation URL (scraped by scripts/cursor_pricing_pyagent.py)
CURSOR_DOCS_URL=https://cursor.com/docs/models-and-pricing

# -----------------------------------------------------------------------------
# 4. Application & Server Settings
# -----------------------------------------------------------------------------

# Public site origin for sitemaps, canonical links, Open Graph, and robots.txt.
# Local development default:
SITE_URL=http://localhost:4321
#
# Production / Cloudflare Pages builds REQUIRE a real public HTTPS origin, e.g.:
#   SITE_URL=https://your-domain.example
# Builds fail if SITE_URL is missing, invalid, or still an *.example.* placeholder.
# For local production builds against localhost only:
#   ALLOW_LOCAL_SITE_URL=1

# Local development port (default: 4321)
PORT=4321
