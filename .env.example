# effiq — local / production env template
# Copy to .env and fill in. Never commit .env.

SITE_URL=https://effiq.example.com
HOST=127.0.0.1
PORT=4321

# Published matrix served by the API
MATRIX_FILE=./data/models-matrix.json

# OpenRouter raw cache used by npm run sync
CACHE_FILE=./data/models-cache.json
OPENROUTER_CACHE=./data/models-cache.json

# Protect POST /api/sync on Node/VPS (unused on Cloudflare Pages)
SYNC_TOKEN=change-me-to-a-long-random-string

# Absolute paths for local sync (CI should use repo-relative paths under data/)
# AA_CATALOG_PATH=/home/sheese/system/data/artificial-analysis/catalog.json
# CURSOR_MODELS_CSV=/home/sheese/system/cursor-models.csv

# Force a live OpenRouter refresh during sync
# OPENROUTER_REFRESH=1

# Optional secrets (GitHub Actions / local only — never bundle into the client)
# ARTIFICIAL_ANALYSIS_API_KEY=
# CURSOR_API_KEY=
# HF_TOKEN=
