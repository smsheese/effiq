# effiq — environment template
# Copy to .env for local development. Never commit .env.

SITE_URL=https://effiq.example.com

# Published matrix served by the static endpoints / UI
MATRIX_FILE=./data/models-matrix.json

# OpenRouter raw cache used by npm run sync
CACHE_FILE=./data/models-cache.json
OPENROUTER_CACHE=./data/models-cache.json

# Force a live OpenRouter refresh during sync (set to 1 to refetch API)
OPENROUTER_REFRESH=1

# Local source file overrides (defaults to data/aa-catalog.json and data/cursor-models.csv)
# AA_CATALOG_PATH=./data/aa-catalog.json
# CURSOR_MODELS_CSV=./data/cursor-models.csv

# -----------------------------------------------------------------------------
# GitHub Actions Secrets (Settings -> Secrets and variables -> Actions -> Secrets)
# These are used by .github/workflows/sync.yml for periodic matrix updates:
# -----------------------------------------------------------------------------
# ARTIFICIAL_ANALYSIS_API_KEY=your_aa_api_key_here
# CURSOR_API_KEY=your_cursor_api_key_here
# HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# Cloudflare Pages Build Environment Variables:
# NONE required! The site builds purely static assets with `npm run build`.
# Optional:
# NODE_VERSION=22
# SITE_URL=https://your-custom-domain.com
# -----------------------------------------------------------------------------
